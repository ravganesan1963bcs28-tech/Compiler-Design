#include <stdio.h>
#include <string.h>

#define MAX_STATES 50
#define MAX_SYMBOLS 20
#define NAME_LEN 20
#define BUF_LEN 100

char states[MAX_STATES][NAME_LEN];
char symbols[MAX_SYMBOLS][NAME_LEN];
int trans[MAX_STATES][MAX_SYMBOLS];
int accepting[MAX_STATES];

int num_states, num_symbols, num_accepting;
int start_state;

/* Find state index */
int get_state_idx(char *name)
{
    for (int i = 0; i < num_states; i++)
    {
        if (strcmp(states[i], name) == 0)
            return i;
    }

    return -1;
}

/* Find symbol index */
int get_symbol_idx(char c)
{
    for (int i = 0; i < num_symbols; i++)
    {
        if (symbols[i][0] == c && symbols[i][1] == '\0')
            return i;
    }

    return -1;
}

/* Check accepting state */
int is_accepting(int state)
{
    for (int i = 0; i < num_accepting; i++)
    {
        if (accepting[i] == state)
            return 1;
    }

    return 0;
}

/* DFA Lexer */
void test_string(char *input)
{
    int len = strlen(input);
    int i = 0;

    printf("\n--- Scanning \"%s\" ---\n", input);

    while (i < len)
    {
        int state = start_state;
        int start = i;
        int last_accept_pos = -1;
        int last_accept_state = -1;

        /* Longest match */
        while (i < len)
        {
            int sym = get_symbol_idx(input[i]);

            /* Unknown symbol */
            if (sym == -1)
                break;

            /* No transition */
            if (trans[state][sym] == -1)
                break;

            /* Valid transition */
            state = trans[state][sym];
            i++;

            /* Remember latest accepting state */
            if (is_accepting(state))
            {
                last_accept_pos = i;
                last_accept_state = state;
            }
        }

        /*
         * If an accepting state was reached,
         * use the longest accepted lexeme.
         */
        if (last_accept_pos != -1)
        {
            printf("Recognized token   : <%.*s, %s>\n",
                   last_accept_pos - start,
                   input + start,
                   states[last_accept_state]);

            /*
             * Re-process characters after
             * the longest accepted token.
             */
            i = last_accept_pos;
        }
        else
        {
            /*
             * Nothing accepted.
             * Consume one character so scanner
             * always makes progress.
             */
            printf("Unrecognized token : %c\n", input[start]);

            i = start + 1;
        }
    }
}

int main()
{
    char temp[NAME_LEN];
    char input[BUF_LEN];

    int choice;

    printf("=== DFA LEXER ===\n\n");

    /* Number of states */
    printf("No. of states: ");
    scanf("%d", &num_states);

    /* State names */
    printf("State names: ");

    for (int i = 0; i < num_states; i++)
    {
        scanf("%s", states[i]);
    }

    /* Number of symbols */
    printf("No. of symbols: ");
    scanf("%d", &num_symbols);

    /* Symbol names */
    printf("Symbol names: ");

    for (int i = 0; i < num_symbols; i++)
    {
        scanf("%s", symbols[i]);
    }

    /* Start state */
    printf("Start state: ");
    scanf("%s", temp);

    start_state = get_state_idx(temp);

    /* Accepting states */
    printf("No. of accepting states: ");
    scanf("%d", &num_accepting);

    if (num_accepting > 0)
    {
        printf("Accepting states: ");

        for (int i = 0; i < num_accepting; i++)
        {
            scanf("%s", temp);
            accepting[i] = get_state_idx(temp);
        }
    }

    /* Transition table */
    printf("\nTransition table:\n");

    for (int i = 0; i < num_states; i++)
    {
        for (int j = 0; j < num_symbols; j++)
        {
            scanf("%s", temp);

            if (strcmp(temp, "#") == 0 ||
                strcmp(temp, "-1") == 0)
            {
                trans[i][j] = -1;
            }
            else
            {
                trans[i][j] = get_state_idx(temp);
            }
        }
    }

    printf("\nDFA ready!\n");

    /* Test loop */
    while (1)
    {
        printf("\n1. Test  2. Exit: ");
        scanf("%d", &choice);

        if (choice == 1)
        {
            printf("Input: ");
            scanf("%s", input);

            test_string(input);
        }
        else if (choice == 2)
        {
            break;
        }
        else
        {
            printf("Invalid choice!\n");
        }
    }

    return 0;
}



