
%{
#include "y.tab.h"
%}

%%

"do"        { return DO; }
"while"     { return WHILE; }
[a-zA-Z_][a-zA-Z0-9_]*  { return ID; }
[0-9]+      { return NUM; }
"+"         { return OP; }
"-"         { return OP; }
"*"         { return OP; }
"/"         { return OP; }
"<="        { return OP; }
">="        { return OP; }
"=="        { return OP; }
"!="        { return OP; }
"<"         { return OP; }
">"         { return OP; }
"("         { return '('; }
")"         { return ')'; }
"{"         { return '{'; }
"}"         { return '}'; }
"="         { return '='; }
";"         { return ';'; }
[ \t\n]+    { /* skip whitespace */ }
.           { return yytext[0]; }

%%

int yywrap()
{
    return 1;
}


%{
#include <stdio.h>
#include <stdlib.h>

extern FILE *yyin;

int yylex();
void yyerror(char *s);
%}

%token DO WHILE ID NUM OP

%%

S : DO '{' STMTLIST '}' WHILE '(' COND ')' ';'
    {
        printf("Valid do-while statement\n");
        exit(0);
    }
    ;

STMTLIST : STMTLIST STMT
         | STMT
         ;

STMT : ID '=' EXPR ';'
     ;

EXPR : ID OP NUM
     | ID OP ID
     | NUM
     | ID
     ;

COND : ID OP NUM
     | ID OP ID
     ;

%%

int main()
{
    FILE *fp = fopen("input.txt", "r");
    if(fp == NULL)
    {
        printf("Error: Cannot open input.txt\n");
        return 1;
    }
    yyin = fp;
    yyparse();
    fclose(fp);
    return 0;
}

void yyerror(char *s)
{
    printf("Invalid do-while statement\n");
    exit(1);
}


