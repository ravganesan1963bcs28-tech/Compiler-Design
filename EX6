%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

extern FILE *yyin;
int yylex();
void yyerror(char *s);

int q = 1, t = 1;
char inc_l[20], inc_a[20], inc_b[20], inc_op[5];
int has_inc_op = 0;

void quad(char *op, char *a1, char *a2, char *res)
{
    printf("%d\t%s\t%s\t%s\t%s\n", q++, op, a1, a2, res);
}
%}

%union {
    char str[20];
}

%token <str> ID NUM RELOP
%token FOR

%type <str> EXPR

%%

S : FOR '(' INIT ';' COND ';' INC ')' '{' STMTLIST '}'
    {
        char tmp[10];
        if(has_inc_op)
        {
            sprintf(tmp, "T%d", t++);
            quad(inc_op, inc_a, inc_b, tmp);
            quad("=", tmp, "-", inc_l);
        }
        else
        {
            quad("=", inc_a, "-", inc_l);
        }
        quad("GOTO", "-", "-", "2");
        quad("LABEL", "-", "-", "L1");
        printf("\nValid for loop\n");
        exit(0);
    }
    ;

INIT : ID '=' NUM
    {
        quad("=", $3, "-", $1);
    }
    | ID '=' ID
    {
        quad("=", $3, "-", $1);
    }
    ;

COND : ID RELOP NUM
    {
        char tmp[10];
        sprintf(tmp, "T%d", t++);
        quad($2, $1, $3, tmp);
        quad("IF_FALSE", tmp, "-", "L1");
    }
    | ID RELOP ID
    {
        char tmp[10];
        sprintf(tmp, "T%d", t++);
        quad($2, $1, $3, tmp);
        quad("IF_FALSE", tmp, "-", "L1");
    }
    ;

INC : ID '=' ID '+' NUM
    {
        strcpy(inc_l, $1);
        strcpy(inc_a, $3);
        strcpy(inc_b, $5);
        strcpy(inc_op, "+");
        has_inc_op = 1;
    }
    | ID '=' ID '-' NUM
    {
        strcpy(inc_l, $1);
        strcpy(inc_a, $3);
        strcpy(inc_b, $5);
        strcpy(inc_op, "-");
        has_inc_op = 1;
    }
    | ID '=' ID '+' ID
    {
        strcpy(inc_l, $1);
        strcpy(inc_a, $3);
        strcpy(inc_b, $5);
        strcpy(inc_op, "+");
        has_inc_op = 1;
    }
    | ID '=' NUM
    {
        strcpy(inc_l, $1);
        strcpy(inc_a, $3);
        has_inc_op = 0;
    }
    ;

STMTLIST : STMTLIST STMT
         | STMT
         ;

STMT : ID '=' EXPR ';'
    {
        quad("=", $3, "-", $1);
    }
    ;

EXPR : ID '+' NUM
    {
        char tmp[10];
        sprintf(tmp, "T%d", t++);
        quad("+", $1, $3, tmp);
        strcpy($$, tmp);
    }
    | ID '-' NUM
    {
        char tmp[10];
        sprintf(tmp, "T%d", t++);
        quad("-", $1, $3, tmp);
        strcpy($$, tmp);
    }
    | ID '*' NUM
    {
        char tmp[10];
        sprintf(tmp, "T%d", t++);
        quad("*", $1, $3, tmp);
        strcpy($$, tmp);
    }
    | ID '/' NUM
    {
        char tmp[10];
        sprintf(tmp, "T%d", t++);
        quad("/", $1, $3, tmp);
        strcpy($$, tmp);
    }
    | ID '+' ID
    {
        char tmp[10];
        sprintf(tmp, "T%d", t++);
        quad("+", $1, $3, tmp);
        strcpy($$, tmp);
    }
    | ID '-' ID
    {
        char tmp[10];
        sprintf(tmp, "T%d", t++);
        quad("-", $1, $3, tmp);
        strcpy($$, tmp);
    }
    | ID '*' ID
    {
        char tmp[10];
        sprintf(tmp, "T%d", t++);
        quad("*", $1, $3, tmp);
        strcpy($$, tmp);
    }
    | ID '/' ID
    {
        char tmp[10];
        sprintf(tmp, "T%d", t++);
        quad("/", $1, $3, tmp);
        strcpy($$, tmp);
    }
    | NUM
    {
        strcpy($$, $1);
    }
    | ID
    {
        strcpy($$, $1);
    }
    ;

%%

int main()
{
    FILE *fp = fopen("input.txt", "r");
    if(fp == NULL)
    {
        printf("Error: Cannot open input.txt\n");
        return 1;
    }
    yyin = fp;
    printf("No\tOp\tArg1\tArg2\tResult\n");
    yyparse();
    fclose(fp);
    return 0;
}

void yyerror(char *s)
{
    printf("Invalid for loop\n");
    exit(1);
}







