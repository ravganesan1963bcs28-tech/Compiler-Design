%{
#include <stdio.h>
#include <string.h>

int has_upper = 0;
int has_lower = 0;
int has_special = 0;
int total_len = 0;
int starts_with_alpha = 0;
%}

%%

^([a-zA-Z])[a-zA-Z0-9!@#$%^&*()_+=\-[\]{}|;':",./<>?]* {
    int i;
    total_len = yyleng;
    starts_with_alpha = 1;

    for(i = 0; i < yyleng; i++) {
        if(yytext[i] >= 'A' && yytext[i] <= 'Z') has_upper = 1;
        else if(yytext[i] >= 'a' && yytext[i] <= 'z') has_lower = 1;
        else if(yytext[i] >= '0' && yytext[i] <= '9') { /* numbers allowed but not required */ }
        else has_special = 1;
    }
}

\n {
    if (starts_with_alpha && total_len > 8 && total_len < 64 && has_upper && has_lower && has_special) {
        printf("Valid Password\n");
    } else {
        printf("Invalid Password\n");
        if (total_len <= 8 || total_len >= 64) printf("- Length must be > 8 and < 64 characters (Current: %d)\n", total_len);
        if (!starts_with_alpha) printf("- Must start with an alphabet\n");
        if (!has_upper) printf("- Missing an uppercase letter\n");
        if (!has_lower) printf("- Missing a lowercase letter\n");
        if (!has_special) printf("- Missing a special character\n");
    }

    // Reset counters for the next line of input
    has_upper = has_lower = has_special = total_len = starts_with_alpha = 0;
    printf("\nEnter password to validate: ");
}

. { /* Ignore characters that don't match the valid pattern sequence */ }

%%

int yywrap() {
    return 1;
}

int main() {
    printf("Enter password to validate: ");
    yylex();
    return 0;
}
